# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (optional — required for persistence/history APIs)
# Local SQLite example:
DATABASE_URL=sqlite:///./signalforge.db
# PostgreSQL placeholder example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/signalforge

# CORS — comma-separated origins; defaults to local Next.js + API dev ports when unset
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Azure OpenAI (optional — required only for live AI responses on /generate-insight)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-10-21

# Set to false to disable Azure OpenAI calls without removing credentials
AI_ENABLED=true

# Leadership Brief AI request controls
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# =============================================================================
# LOCAL DEVELOPMENT ONLY
# Forbidden when APP_ENV=production. Never use these against staging/production
# or customer environments. window.__SIGNALFORGE_TEST_AUTH__ is likewise
# local/test only — never production.
# =============================================================================
AUTH_MODE=local_development
# HS256 signing secret for `python -m app.security issue-dev-token`.
# Must be at least 32 characters. No default is provided. Must be ABSENT in production.
SIGNALFORGE_LOCAL_AUTH_SECRET=replace-with-a-long-local-dev-secret
# OpenAPI /docs — allowed locally; must be false in production
DOCS_ENABLED=true

# =============================================================================
# PRODUCTION REQUIRED (placeholders only — set in the host secret store)
# Fail-closed validation lives in backend/app/security/config.py
# =============================================================================
# APP_ENV=production
# AUTH_MODE=entra_oidc
# ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# ENTRA_AUDIENCE=api://your-signalforge-api-app-id
# ENTRA_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# ENTRA_ALLOWED_TENANT_IDS=<entra-tenant-guid>
# DOCS_ENABLED=false
# TRUSTED_HOSTS=api.example.com
# HSTS_ENABLED=true
# LOG_FORMAT=json
# CORS_ORIGINS=https://app.example.com
# DATABASE_URL=postgresql://signalforge_app:PASSWORD@HOST:5432/signalforge
# Optional role name overrides (defaults shown):
# DB_APPLICATION_ROLE=signalforge_app
# DB_MIGRATION_ROLE=signalforge_migrator

# =============================================================================
# Observability (optional knobs — see backend/app/core/config.py)
# Defaults are safe for local/test. Production exporter paths are NOT claimed
# as production-validated unless separately evidenced.
# =============================================================================
# OBSERVABILITY_ENABLED=true
# LOG_FORMAT=text
# OTEL_SERVICE_NAME=signalforge-api
# OTEL_SERVICE_VERSION=0.0.0
# OTEL_EXPORTER_MODE=none
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS_SECRET_REF=
# OTEL_EXPORT_TIMEOUT_SECONDS=10
# OTEL_BATCH_MAX_QUEUE_SIZE=2048
# OTEL_BATCH_MAX_EXPORT_SIZE=512
# OTEL_TRACE_SAMPLE_RATIO=1.0
# METRIC_ROLLUP_INTERVAL_SECONDS=60
# METRIC_RETENTION_DAYS=30
# AI_EVAL_ENABLED=true
# AI_EVAL_RELEASE_GATE_ENABLED=true
# ALERT_EVALUATION_ENABLED=true

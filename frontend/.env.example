# SignalForge frontend — environment variables
#
# Do NOT put JWTs, client secrets, or Entra credentials in frontend env files.
# Tokens are provided at runtime (in-memory). window.__SIGNALFORGE_TEST_AUTH__
# is permitted only for local development, Cursor non-production workspaces,
# and automated browser tests — never staging/production/customer environments.

# Public backend API base URL (no trailing slash required)
#
# Local development:
NEXT_PUBLIC_SIGNALFORGE_API_BASE_URL=http://127.0.0.1:8000
#
# Production / hosted frontend (example placeholder):
# NEXT_PUBLIC_SIGNALFORGE_API_BASE_URL=https://api.example.com
